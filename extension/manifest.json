{
  "manifest_version": 3,
  "name": "Focus Bars",
  "version": "1.0.1",
  "description": "A different bookmark bar for each window's focus.",
  "permissions": [
    "bookmarks",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Focus Bars",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Open the Focus Bars menu"
    },
    "next-focus": {
      "suggested_key": {
        "default": "Alt+Shift+Right",
        "mac": "MacCtrl+Shift+Right"
      },
      "description": "Switch this window to the next focus"
    },
    "previous-focus": {
      "suggested_key": {
        "default": "Alt+Shift+Left",
        "mac": "MacCtrl+Shift+Left"
      },
      "description": "Switch this window to the previous focus"
    }
  }
}
